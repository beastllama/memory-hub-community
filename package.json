{
  "name": "memory-hub-community",
  "version": "0.1.0",
  "private": true,
  "description": "Review notes from local project folders and save them as Markdown.",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=11.1.1"
  },
  "scripts": {
    "build": "turbo run build",
    "start": "node apps/local/dist/server.js --open",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify": "prettier --check . && turbo run typecheck && turbo run test && turbo run build"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.6",
    "typescript": "6.0.3"
  }
}
